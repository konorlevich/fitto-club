# Fitto Club - every variable the service reads. Copy to .env for local runs;
# on Railway paste them into the service's Variables. Placeholders only.

# --- runtime ------------------------------------------------------------
# Empty: 8080. Railway sets PORT itself.
PORT=8080
# "production" turns on Secure cookies, HSTS, the www->apex redirect and the
# launch gate below. Anything else (or empty) is development.
ENV=development
# Canonical origin for canonical links, hreflang, sitemap and OG images.
# Empty: https://fitto.club (the real domain).
BASE_URL=https://fitto.club

# --- i18n ---------------------------------------------------------------
# Enabled locales, comma-separated, from: en,ru,ka. Must include en.
# Empty: en,ru,ka. Turn a locale on only after its native review (TASKS #25).
LOCALES=en,ru,ka

# --- storage ------------------------------------------------------------
# Directory on the Railway volume: content.db, uploads/, backups/.
# Empty: ./data (fine locally, WRONG on Railway - ephemeral disk).
DATA_DIR=./data

# --- analytics ----------------------------------------------------------
# GTM container (GTM-XXXXXXX) or GA4 measurement id (G-XXXXXXXXXX).
# Empty: no tag, no consent banner, zero third-party requests.
# Malformed (e.g. a UA- id): fatal at boot.
GTM_ID=

# --- launch gate --------------------------------------------------------
# In production the service refuses to boot while facts in
# internal/content/seed.go (Pending) are unconfirmed by the club.
# "1" overrides that for a staging deploy. Empty: gate enforced.
ALLOW_PENDING=
